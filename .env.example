# Secretos de SecureDNS. Copiá este archivo a .env y completá lo que uses.
# El .env está en .gitignore: nunca se sube al repositorio.

# Avisos por Telegram (opcional). Se activan además con
# intel.telegram_enabled: true en config/config.yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Contraseña de la API de Pi-hole (opcional). Se activa además con
# pihole.habilitado: true en config/config.yaml.
# Generala en el panel de Pi-hole como "app password": se revoca sola sin
# tocar tu contraseña y funciona aunque tengas 2FA puesto.
PIHOLE_PASSWORD=
